{
  "name": "workout-tracker-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/gen-migrations-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-migrations-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "migrate:prod": "node --env-file=.env.production.local scripts/migrate.mjs",
    "db:target": "node --env-file=.env.local scripts/target.mjs",
    "db:target:prod": "node --env-file=.env.production.local scripts/target.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:clear": "node --env-file=.env.local scripts/seed-clear.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "mcp-handler": "^2.1.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
