# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon pooled connection string (hostname contains "-pooler").
# Neon Console -> your project -> Connect -> Pooled connection
DATABASE_URL=

# Neon direct connection string (same host without "-pooler").
# Optional. Used only by `npm run migrate`, which prefers a direct connection for DDL.
DATABASE_URL_UNPOOLED=

# Shared secret. Every MCP tool and API route checks this before doing anything.
# Generate one with:  openssl rand -base64 32
API_SECRET=
