# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# TWO env files, and which one is the default matters more than what is in them:
#
#   .env.local             the Neon DEV BRANCH. Loaded by npm run dev, seed, seed:clear,
#                          migrate, db:target — everything except the two commands below.
#   .env.production.local  production. Loaded ONLY by migrate:prod and db:target:prod.
#
# The point is that forgetting fails safe. This repo started with production in .env.local,
# which meant every local command reached production and the only thing standing between a
# stray `npm run seed` and real data was remembering. Dev is now the default; production has
# to be named. Copy this file to both, and change APP_ENV in the production one.

# Neon pooled connection string (hostname contains "-pooler").
# Neon Console -> your project -> Branches -> pick the branch -> Connect -> Pooled
DATABASE_URL=

# Neon direct connection string (same host without "-pooler").
# Optional. Used by migrate, seed and seed:clear, which prefer a direct connection for DDL.
DATABASE_URL_UNPOOLED=

# Shared secret. Every MCP tool and API route checks this before doing anything.
# Generate one with:  openssl rand -hex 32
#
# Use hex, not base64. This value goes in the MCP URL path
# (/api/mcp/<secret>), and base64's "/" and "+" characters break the path.
API_SECRET=

# development | production. Read by backend/scripts/lib/env.mjs.
#
# seed and seed:clear refuse outright when this is production; migrate asks for the database
# name first. Unset counts as production, because the unknown case is the dangerous one.
#
# This is a label a human maintains, so it is cross-checked: if it says development while the
# connection points at the same host as .env.production.local, every guarded script refuses.
# That is the one mistake — pasting the prod string in and leaving the label alone — that
# would otherwise defeat the whole arrangement silently.
APP_ENV=development
