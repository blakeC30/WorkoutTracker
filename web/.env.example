# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Neither of these is NEXT_PUBLIC_, and neither ever will be. They are read only by
# server-side code in web/, which fetches from the backend on the browser's behalf.
# The browser never sees the secret and never talks to Postgres.

# Where the backend lives. http://localhost:3000 for local dev,
# https://<your-backend>.vercel.app once deployed.
BACKEND_URL=

# Must match API_SECRET in backend/.env.local exactly.
API_SECRET=

# --- Dashboard login -----------------------------------------------------------------------
#
# Generate both with:  npm run auth:setup
#
# Without these the dashboard throws on every request rather than opening to the public. That
# is deliberate: a missing secret must never be the same thing as no lock.

# Signs the session cookie. Changing it signs out every device immediately, which is how you
# revoke access to a phone you no longer have.
SESSION_SECRET=

# scrypt hash of the password, as <salt-hex>:<key-hex>. The password itself is stored nowhere
# and cannot be recovered from this.
AUTH_PASSWORD_HASH=

# Switches the login off for local development. Leave this out of .env.local unless you want
# it; leave it out of Vercel always.
#
# It takes effect only when NODE_ENV is not 'production', which is a property of how the code
# was built rather than a value anyone sets. On Vercel, and in a local `npm run start`, it is
# ignored and logged. So the worst case of pasting this whole file into a deployment dashboard
# is a line in the logs, not an open site.
#
# With this on, SESSION_SECRET and AUTH_PASSWORD_HASH above are not needed at all — a fresh
# clone can run `npm run dev` without generating anything.
# AUTH_DISABLED=true
