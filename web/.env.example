# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Neither of these is NEXT_PUBLIC_, and neither ever will be. They are read only by
# server-side code in web/, which fetches from the backend on the browser's behalf.
# The browser never sees the secret and never talks to Postgres.

# Where the backend lives. http://localhost:3000 for local dev,
# https://<your-backend>.vercel.app once deployed.
BACKEND_URL=

# Must match API_SECRET in backend/.env.local exactly.
API_SECRET=
